mas exploration {
    agent explorer : explorer_v1.asl {
        ag-class: vesna.VesnaAgent
        beliefs: address(localhost)
                 port(8080)
        join: main
    }
    agent vesna_agent : vesnaConARTEFATTI.asl {
        ag-class: vesna.VesnaAgent
        beliefs: address(localhost)
                 port(8081)
        join: main
    }
    workspace main {
        artifact envManager: artifact.EnvManagerArtifact("envManager")
    }
}